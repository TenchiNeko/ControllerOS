<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>controlleros</AssemblyName>
    <Version>0.1.0-alpha.1</Version>
    <ControllerOSCommit Condition="'$(ControllerOSCommit)' == ''">unknown</ControllerOSCommit>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ControllerOS.Core\ControllerOS.Core.csproj" />
    <ProjectReference Include="..\ControllerOS.Windows\ControllerOS.Windows.csproj" />
    <AssemblyMetadata Include="ControllerOSCommit" Value="$(ControllerOSCommit)" />
    <InternalsVisibleTo Include="ControllerOS.Tests" />
  </ItemGroup>
</Project>
