<Window x:Class="ControllerOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ControllerOS Alpha 0.1"
        Height="820"
        Width="1180"
        MinHeight="640"
        MinWidth="900"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewKeyUp="Window_PreviewKeyUp"
        PreviewGotKeyboardFocus="Window_PreviewGotKeyboardFocus"
        Deactivated="Window_Deactivated"
        Closed="Window_Closed">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Left" FontSize="22" FontWeight="SemiBold" Text="ControllerOS" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Text="Ready" />
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">
            <TabItem Header="Profile &amp; runtime">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Profile name" />
                        <TextBox x:Name="ProfileNameBox" Width="150" Text="My profile" Margin="0,0,10,0" />
                        <Button Content="Load…" Click="LoadProfile_Click" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="Save…" Click="SaveProfile_Click" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="Compile" Click="Compile_Click" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="Start" Click="Start_Click" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="Stop" Click="Stop_Click" Margin="0,0,6,0" Padding="10,4" />
                        <Button Content="Disable now" Click="Disable_Click" Margin="0,0,12,0" Padding="10,4" />
                        <TextBlock VerticalAlignment="Center" Margin="0,0,6,0" Text="Input source" />
                        <ComboBox x:Name="InputSourceBox" Width="170" SelectedIndex="0" Margin="0,0,12,0" SelectionChanged="InputSourceBox_SelectionChanged">
                            <ComboBoxItem Content="Keyboard test input" Tag="keyboard" />
                            <ComboBoxItem Content="XInput slot 0" Tag="0" />
                            <ComboBoxItem Content="XInput slot 1" Tag="1" />
                            <ComboBoxItem Content="XInput slot 2" Tag="2" />
                            <ComboBoxItem Content="XInput slot 3" Tag="3" />
                        </ComboBox>
                        <CheckBox x:Name="VirtualOutputEnabled" VerticalAlignment="Center" Content="Xbox virtual output" />
                    </WrapPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ScriptEditor"
                                 Grid.Column="0"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 FontFamily="Consolas"
                                 FontSize="14"
                                 HorizontalScrollBarVisibility="Auto"
                                 VerticalScrollBarVisibility="Auto"
                                 TextWrapping="NoWrap" />
                        <Grid Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="150" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" FontWeight="SemiBold" Text="Compile and runtime diagnostics" Margin="0,0,0,6" />
                            <ListBox x:Name="DiagnosticsList" Grid.Row="1" />
                            <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Current output" Margin="0,10,0,6" />
                            <ListBox x:Name="OutputInspector" Grid.Row="3" />
                        </Grid>
                    </Grid>

                    <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
                               Text="Keyboard test map: WASD left stick, arrows right stick, Space SOUTH, E EAST, Q WEST, R NORTH, U/I bumpers, left/right Shift triggers, Enter MENU, Tab VIEW, F1 GUIDE, Ctrl stick clicks, keypad 8/2/4/6 D-pad. Select an XInput slot to use a connected Windows controller. Escape disables a running profile." />
                </Grid>
            </TabItem>

            <TabItem Header="Devices &amp; live input">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,8">
                            <Button Content="Refresh devices" Click="RefreshDevices_Click" Padding="10,4" />
                            <Button Content="Open teaching" Click="OpenTeaching_Click" Padding="10,4" Margin="8,0,0,0" />
                            <TextBlock x:Name="DeviceStatusText" Margin="12,0,0,0" VerticalAlignment="Center" Text="Device list not loaded" />
                        </DockPanel>
                        <ListBox x:Name="DeviceList" Grid.Row="1" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="InputInspectorHeader" Grid.Row="0" FontWeight="SemiBold" Text="Live normalized input (keyboard test input)" Margin="0,0,0,8" />
                        <ListBox x:Name="InputInspector" Grid.Row="1" />
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Teach &amp; report">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="Load synthetic unknown device" Click="LoadTeachingFixture_Click" Padding="10,4" Margin="0,0,8,0" />
                        <ComboBox x:Name="TeachingControlBox" Width="190" Margin="0,0,8,0" />
                        <Button Content="Observe fixture samples" Click="ObserveControl_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Skip control" Click="SkipControl_Click" Padding="10,4" Margin="0,0,14,0" />
                        <Button Content="Preview mapping" Click="PreviewTeaching_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Save mapping" Click="SaveTeaching_Click" Padding="10,4" Margin="0,0,8,0" />
                        <Button Content="Export report…" Click="ExportReport_Click" Padding="10,4" />
                    </WrapPanel>
                    <TextBlock x:Name="TeachingStatusText" Grid.Row="1" Margin="0,0,0,10" Text="Load the synthetic unknown-device fixture to exercise teaching and calibration." />
                    <TextBox x:Name="TeachingPreviewBox"
                             Grid.Row="2"
                             AcceptsReturn="True"
                             FontFamily="Consolas"
                             FontSize="13"
                             IsReadOnly="True"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Margin="0,9,0,0" Foreground="Gray"
                   Text="Alpha 0.1: synthetic teaching and keyboard input are available; physical controller validation remains unverified." />
    </Grid>
</Window>
